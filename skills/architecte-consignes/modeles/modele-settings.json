{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.key)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(git push *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(Move-Item *)",
      "PowerShell(Rename-Item *)",
      "PowerShell(git push *)",
      "mcp__terminal__run_in_terminal"
    ],
    "allow": []
  }
}
